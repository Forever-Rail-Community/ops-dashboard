# --- Discord login (create an application at https://discord.com/developers/applications) ---
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# Long random string (32+ characters) that secures login sessions. Generate one with: openssl rand -base64 32
NUXT_APP_SECRET=

# --- Access control ---
# Your Forever Rail Discord server (guild) ID
NUXT_DISCORD_GUILD_ID=
# Your own Discord USER ID (comma-separate several). These people are always admins, so you can't lock yourself out.
# Find it: Discord > User Settings > Advanced > Developer Mode on, then right-click yourself > Copy User ID.
NUXT_BOOTSTRAP_ADMIN_IDS=
# Optional. Only used the very first time, to fill in the starting Discord role mappings.
# After that, manage roles on the Admin > Access page.
NUXT_DISCORD_ADMIN_ROLE_IDS=
NUXT_DISCORD_DISPATCHER_ROLE_IDS=
NUXT_DISCORD_MEMBER_ROLE_IDS=

# --- Database (set automatically when you add Neon Postgres from the Vercel marketplace) ---
# DATABASE_URL=

# --- Agent ---
# Must match INGEST_KEY in the agent's .env
NUXT_INGEST_KEY=
# Seconds without an update before the dashboard shows the agent as quiet
NUXT_STALE_AFTER_SEC=90

# --- Storage (set automatically when you add Upstash Redis from the Vercel marketplace) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
